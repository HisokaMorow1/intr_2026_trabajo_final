# ==============================================================================
# 4.5. Construcción de grupos y selección de candidatos diferenciales
# ==============================================================================

"""
import pandas as pd
import numpy as np
from pathlib import Path

# Definir rutas
DIR_TABLAS = Path("../results/tables")

# Cargar los datos necesarios
variantes_dna = pd.read_csv(DIR_TABLAS / "variantes_dna_para_integracion.csv")
cambios_proteicos = pd.read_csv(DIR_TABLAS / "frecuencias_cambios_proteicos.csv")
carga_proteica = pd.read_csv(DIR_TABLAS / "carga_proteica.csv")
clinica = pd.read_csv(DIR_TABLAS / "clinica_para_integracion.csv")
integrado = pd.read_csv(DIR_TABLAS / "dataset_integrado_reducido.csv")

print("Datos cargados correctamente.")
print(f"Dataset integrado: {integrado.shape}")

# ------------------------------------------------------------------------------
# PASO 1: Seleccionar candidatos de DNA (variantes con alta diferencia)
# ------------------------------------------------------------------------------

# Filtrar variantes con diferencia de frecuencia > 10% y al menos 10 portadores
candidatos_dna = variantes_dna[
    (variantes_dna["n_total"] >= 10) &
    (variantes_dna["diferencia_puntos"].abs() > 10)
].sort_values("diferencia_puntos", ascending=False).copy()

print(f"\nCandidatos de DNA encontrados: {len(candidatos_dna)}")
print("Top 5 candidatos de DNA:")
display(candidatos_dna.head(5)[["variante", "pct_sano", "pct_alzheimer", "diferencia_puntos"]])



# ------------------------------------------------------------------------------
# PASO 2: Seleccionar candidatos de proteína (cambios con alta diferencia)
# ------------------------------------------------------------------------------

# Filtrar cambios proteicos con diferencia > 10% y al menos 10 portadores
candidatos_prot = cambios_proteicos[
    (cambios_proteicos["n_total"] >= 10) &
    (cambios_proteicos["diferencia_puntos"].abs() > 10)
].sort_values("diferencia_puntos", ascending=False).copy()

print(f"\nCandidatos proteicos encontrados: {len(candidatos_prot)}")
print("Top 5 candidatos proteicos:")
display(candidatos_prot.head(5)[["cambio_id", "pct_sano", "pct_alzheimer", "diferencia_puntos"]])

# ------------------------------------------------------------------------------
# PASO 3: Cruzar DNA ↔ Proteína para encontrar candidatos con efecto proteico
# ------------------------------------------------------------------------------

# Extraer el gen de cada variante de DNA
candidatos_dna["gene"] = candidatos_dna["variante"].str.split(":").str[0]

# Extraer el gen de cada cambio proteico
candidatos_prot["gene"] = candidatos_prot["cambio_id"].str.split(":").str[0]

# Buscar coincidencias por gen
candidatos_dna_prot = pd.merge(
    candidatos_dna,
    candidatos_prot,
    on="gene",
    suffixes=("_dna", "_prot"),
    how="inner"
)

# Ordenar por la diferencia combinada (DNA + proteína)
candidatos_dna_prot["diferencia_combinada"] = (
    candidatos_dna_prot["diferencia_puntos_dna"].abs() +
    candidatos_dna_prot["diferencia_puntos_prot"].abs()
)
candidatos_dna_prot = candidatos_dna_prot.sort_values(
    "diferencia_combinada", ascending=False
)

print(f"\nCandidatos con efecto DNA → Proteína: {len(candidatos_dna_prot)}")
print("Top 5 candidatos DNA ↔ Proteína:")
display(candidatos_dna_prot.head(5)[[
    "gene", "variante", "diferencia_puntos_dna",
    "cambio_id", "diferencia_puntos_prot", "diferencia_combinada"
]])

# ------------------------------------------------------------------------------
# PASO 4: Seleccionar los mejores candidatos integrados (Grupo de interés)
# ------------------------------------------------------------------------------

# Tomar los 3 mejores candidatos DNA → Proteína
top_candidatos = candidatos_dna_prot.head(3)

# Crear una tabla resumen de los candidatos seleccionados
candidatos_seleccionados = []

for idx, row in top_candidatos.iterrows():
    gene = row["gene"]
    variante_dna = row["variante"]
    cambio_prot = row["cambio_id"]

    # Obtener estadísticas de DNA
    pct_sano_dna = row["pct_sano_dna"]
    pct_alz_dna = row["pct_alzheimer_dna"]
    diff_dna = row["diferencia_puntos_dna"]

    # Obtener estadísticas de proteína
    pct_sano_prot = row["pct_sano_prot"]
    pct_alz_prot = row["pct_alzheimer_prot"]
    diff_prot = row["diferencia_puntos_prot"]

    # Buscar la columna de la variante en el dataset integrado
    col_variante = f"{variante_dna}"

    # Verificar si la columna existe en el dataset integrado
    if col_variante in integrado.columns:
        # Calcular estadísticas clínicas para portadores vs no portadores
        portadores = integrado[integrado[col_variante] == 1]
        no_portadores = integrado[integrado[col_variante] == 0]

        # Seleccionar variables clínicas relevantes
        vars_clinicas = ["age", "systolic_bp_mmHg", "hypertension", "family_history_alzheimer"]

        clinicas = []
        for var in vars_clinicas:
            if var in integrado.columns:
                media_port = portadores[var].mean()
                media_no_port = no_portadores[var].mean()
                clinicas.append({
                    "variable": var,
                    "media_portadores": round(media_port, 2),
                    "media_no_portadores": round(media_no_port, 2),
                    "diferencia": round(media_port - media_no_port, 2)
                })

        # Agregar el candidato a la lista
        candidatos_seleccionados.append({
            "gene": gene,
            "variante_dna": variante_dna,
            "cambio_proteico": cambio_prot,
            "frecuencia_dna_alzheimer_%": round(pct_alz_dna, 1),
            "frecuencia_dna_sano_%": round(pct_sano_dna, 1),
            "diferencia_dna_%": round(diff_dna, 1),
            "frecuencia_prot_alzheimer_%": round(pct_alz_prot, 1),
            "frecuencia_prot_sano_%": round(pct_sano_prot, 1),
            "diferencia_prot_%": round(diff_prot, 1),
            "n_portadores": row["n_total_dna"],
            "clinica_destacada": clinicas
        })

# ------------------------------------------------------------------------------
# PASO 5: Presentación de los candidatos diferenciales
# ------------------------------------------------------------------------------

print("\n" + "="*80)
print("CANDIDATOS DIFERENCIALES SELECCIONADOS")
print("="*80)

for i, cand in enumerate(candidatos_seleccionados, 1):
    print(f"\n--- Candidato {i}: {cand['gene']} ---")
    print(f"Variante de DNA: {cand['variante_dna']}")
    print(f"Cambio proteico: {cand['cambio_proteico']}")
    print(f"Número de portadores: {cand['n_portadores']}")
    print(f"\nFrecuencia en DNA:")
    print(f"  Alzheimer: {cand['frecuencia_dna_alzheimer_%']}%")
    print(f"  Sano:      {cand['frecuencia_dna_sano_%']}%")
    print(f"  Diferencia: {cand['diferencia_dna_%']} puntos porcentuales")
    print(f"\nFrecuencia en proteína:")
    print(f"  Alzheimer: {cand['frecuencia_prot_alzheimer_%']}%")
    print(f"  Sano:      {cand['frecuencia_prot_sano_%']}%")
    print(f"  Diferencia: {cand['diferencia_prot_%']} puntos porcentuales")
    print(f"\nCaracterísticas clínicas (portadores vs no portadores):")
    for clin in cand["clinica_destacada"]:
        print(f"  {clin['variable']}: {clin['media_portadores']} vs {clin['media_no_portadores']} (dif: {clin['diferencia']})")

# ------------------------------------------------------------------------------
# PASO 6: Crear tabla resumen de candidatos (para informe final)
# ------------------------------------------------------------------------------

tabla_candidatos = pd.DataFrame([{
    "Candidato": f"{c['gene']}",
    "Variante DNA": c['variante_dna'],
    "Cambio Proteico": c['cambio_proteico'],
    "Portadores": c['n_portadores'],
    "Dif. DNA (pp)": c['diferencia_dna_%'],
    "Dif. Proteína (pp)": c['diferencia_prot_%'],
    "Edad (portadores)": c['clinica_destacada'][0]['media_portadores'] if c['clinica_destacada'] else None,
    "Edad (no portadores)": c['clinica_destacada'][0]['media_no_portadores'] if c['clinica_destacada'] else None,
    "Hipertensión (portadores)": None,  # Se puede agregar si se desea
} for c in candidatos_seleccionados])

# Guardar la tabla de candidatos
tabla_candidatos.to_csv(DIR_TABLAS / "candidatos_diferenciales.csv", index=False)
print("\nTabla de candidatos guardada en:", DIR_TABLAS / "candidatos_diferenciales.csv")
display(tabla_candidatos)

# ==============================================================================
# RESUMEN FINAL DE CANDIDATOS DIFERENCIALES
# ==============================================================================

print("\n" + "="*80)
print("RESUMEN DE CANDIDATOS DIFERENCIALES")
print("="*80)

print("\nEste análisis ha identificado los siguientes candidatos diferenciales que")
print("cumplen con los criterios establecidos en la guía:")

for i, cand in enumerate(candidatos_seleccionados, 1):
    print(f"\n{i}. Gen {cand['gene']}:")
    print(f"   - Variante {cand['variante_dna']} → Cambio proteico {cand['cambio_proteico']}")
    print(f"   - Presente en {cand['n_portadores']} pacientes de la cohorte")
    print(f"   - Diferencia de frecuencia: {cand['diferencia_dna_%']} pp en DNA, {cand['diferencia_prot_%']} pp en proteína")
    print(f"   - Relación clínica: los portadores presentan diferencias en variables clínicas")

print("\n" + "-"*80)
print("LIMITACIONES:")
print("- Todos los datos son sintéticos, las asociaciones encontradas no son")
print("  evidencia clínica real.")
print("- Los candidatos seleccionados deben interpretarse como patrones descriptivos")
print("  dentro de esta cohorte sintética, no como marcadores diagnósticos.")
print("="*80)

