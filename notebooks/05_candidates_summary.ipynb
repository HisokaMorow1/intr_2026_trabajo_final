from pathlib import Path
import numpy as np
import pandas as pd

# Definición de rutas del proyecto
DIR_PROYECTO = Path.cwd().parent
DIR_TABLAS = DIR_PROYECTO / "results" / "tables"
DIR_TABLAS.mkdir(parents=True, exist_ok=True)

# 1. Cargar datos procesados de cada capa omica y clínica
clinica = pd.read_csv(DIR_TABLAS / "clinica_para_integracion.csv")
dna = pd.read_csv(DIR_TABLAS / "dna_para_integracion.csv")
proteina = pd.read_csv(DIR_TABLAS / "proteina_para_integracion.csv")

# 2. Evitar colisión de columnas no descriptivas al integrar
dna_limpio = dna.drop(
    columns=["alzheimer", "categoria_carga"], errors="ignore"
)
proteina_limpia = proteina.drop(columns=["alzheimer"], errors="ignore")

# 3. Merge multicapa por patient_id
integrado = clinica.merge(dna_limpio, on="patient_id", how="inner").merge(
    proteina_limpia, on="patient_id", how="inner"
)

# 4. Mapear origen de cada variable
cols_clinica = [c for c in clinica.columns if c not in ("patient_id", "alzheimer")]
cols_dna = [
    c
    for c in dna.columns
    if c not in ("patient_id", "alzheimer", "categoria_carga")
]
cols_prot = [c for c in proteina.columns if c not in ("patient_id", "alzheimer")]

origen_capa = {}
for c in cols_clinica:
    origen_capa[c] = "Clínica"
for c in cols_dna:
    origen_capa[c] = "DNA"
for c in cols_prot:
    origen_capa[c] = "Proteína"


# 5. Función para calcular d de Cohen
def d_cohen(grupo_caso, grupo_control):
    n_caso, n_ctrl = len(grupo_caso), len(grupo_control)
    var_caso, var_ctrl = grupo_caso.var(ddof=1), grupo_control.var(ddof=1)
    s_pooled = np.sqrt(
        ((n_caso - 1) * var_caso + (n_ctrl - 1) * var_ctrl)
        / (n_caso + n_ctrl - 2)
    )
    return (
        (grupo_caso.mean() - grupo_control.mean()) / s_pooled
        if s_pooled > 0
        else 0.0
    )


# 6. Cálculo de métricas
casos = integrado[integrado["alzheimer"] == 1]
controles = integrado[integrado["alzheimer"] == 0]

filas = []
for var, capa in origen_capa.items():
    col = integrado[var]
    if not np.issubdtype(col.dtype, np.number):
        continue

    es_binaria = set(col.dropna().unique()) <= {0, 1}
    m_ctrl = controles[var].mean()
    m_caso = casos[var].mean()
    d_val = d_cohen(casos[var], controles[var])

    filas.append({
        "Variable": var,
        "Capa": capa,
        "Tipo": "Binaria" if es_binaria else "Numérica",
        "Media_Sano": m_ctrl,
        "Media_Alzheimer": m_caso,
        "Diferencia": m_caso - m_ctrl,
        "d_Cohen": d_val,
        "Abs_d_Cohen": abs(d_val),
    })

# 7. Formatear y exportar la tabla final
df_candidatos = pd.DataFrame(filas).sort_values(
    by="Abs_d_Cohen", ascending=False
).reset_index(drop=True)
df_candidatos.round(4).to_csv(
    DIR_TABLAS / "tabla_seleccion_candidatos_diferenciales.csv", index=False
)

print("Tabla comparativa generada exitosamente. Top 10 candidatos:")
print(
    df_candidatos[[
        "Variable",
        "Capa",
        "Media_Sano",
        "Media_Alzheimer",
        "d_Cohen",
    ]].head(10)
)

rom pathlib import Path
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

# Configuración estética
sns.set_theme(style="whitegrid", context="paper")
PALETA = {"Clínica": "#7570b3", "DNA": "#2b5c8f", "Proteína": "#d95f02"}

DIR_PROYECTO = Path.cwd().parent
DIR_TABLAS = DIR_PROYECTO / "results" / "tables"
DIR_FIGURAS = DIR_PROYECTO / "results" / "figures" / "integracion"
DIR_FIGURAS.mkdir(parents=True, exist_ok=True)

# Cargar tabla generada
df_candidatos = pd.read_csv(
    DIR_TABLAS / "tabla_seleccion_candidatos_diferenciales.csv"
)

# --- GRÁFICO 1: Top 15 Candidatos Diferenciales ---
plt.figure(figsize=(9, 6))
top_15 = df_candidatos.head(15).copy()

sns.barplot(
    data=top_15,
    x="d_Cohen",
    y="Variable",
    hue="Capa",
    dodge=False,
    palette=PALETA,
)

plt.axvline(
    x=0.8, color="red", linestyle="--", alpha=0.7, label="Efecto grande (|d| ≥ 0.8)"
)
plt.axvline(x=-0.8, color="red", linestyle="--", alpha=0.7)

plt.title(
    "Top 15 Candidatos Diferenciales (Sanos vs. Alzheimer)",
    fontsize=13,
    fontweight="bold",
)
plt.xlabel("Tamaño del Efecto ($d$ de Cohen)", fontsize=11)
plt.ylabel("Variable / Candidato", fontsize=11)
plt.legend(title="Origen de Capa", loc="lower right")

plt.savefig(
    DIR_FIGURAS / "top_15_candidatos_diferenciales.png",
    dpi=300,
    bbox_inches="tight",
)
plt.close()

# --- GRÁFICO 2: Distribución de Magnitud de Efecto por Capa ---
plt.figure(figsize=(8, 5))

sns.boxplot(
    data=df_candidatos, x="Capa", y="Abs_d_Cohen", palette=PALETA, width=0.4
)
sns.stripplot(
    data=df_candidatos,
    x="Capa",
    y="Abs_d_Cohen",
    color="black",
    alpha=0.4,
    jitter=0.2,
)

plt.title(
    "Distribución de la Magnitud de Efecto (|d|) por Capa",
    fontsize=13,
    fontweight="bold",
)
plt.xlabel("Capa de Datos", fontsize=11)
plt.ylabel("|d de Cohen|", fontsize=11)

plt.savefig(
    DIR_FIGURAS / "distribucion_efecto_por_capa.png",
    dpi=300,
    bbox_inches="tight",
)
plt.close()

print(f"Gráficos exportados correctamente en: {DIR_FIGURAS}")

